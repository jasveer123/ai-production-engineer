ENV=development
PORT=8000
TEMPORAL_ADDRESS=localhost:7233
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Set ANTHROPIC_API_KEY or GEMINI_API_KEY (AI_PROVIDER=auto picks Anthropic first). Never commit keys.
ANTHROPIC_API_KEY=
# OpenAI is only used with AI_PROVIDER=openai (model comparison, Phase 9).
OPENAI_API_KEY=
OPENAI_MODEL=
TEMPORAL_TASK_QUEUE=ai
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=ape-minio
S3_SECRET_KEY=ape-minio-secret
S3_BUCKET=ape-artifacts
# Cheapest model that passes the evals (ADR-025). Effort is the cost control: low | medium | high.
AI_PROVIDER=anthropic
AI_MODEL=claude-haiku-5-5
AI_EFFORT=medium
# Optional: write fixes and tests with a stronger model. Unset = same as AI_MODEL.
AI_FIX_MODEL=
AI_FIX_EFFORT=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
