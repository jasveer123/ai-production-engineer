S3_ACCESS_KEY=ape-minio
S3_SECRET_KEY=ape-minio-secret
S3_BUCKET=ape-artifacts
AI_MODEL=claude-opus-5-5
AI_EFFORT=high
AI_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
