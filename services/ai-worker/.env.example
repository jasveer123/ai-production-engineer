ENV=development
PORT=8000
TEMPORAL_ADDRESS=localhost:7233
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Set ANTHROPIC_API_KEY or GEMINI_API_KEY (AI_PROVIDER=auto picks Anthropic first). Never commit keys.
ANTHROPIC_API_KEY=
