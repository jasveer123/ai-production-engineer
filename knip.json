{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": { "entry": ["scripts/*.{js,mjs,ts}"] },
    "apps/web": { "entry": ["src/app/**/{page,layout,route,loading,error,not-found}.tsx"] },
    "services/api": { "entry": ["src/main.ts", "test/**/*.ts"] },
